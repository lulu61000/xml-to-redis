{
  "name": "xml-to-redis",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "echo 'Ready. Try:  ./export.sh -v config.xml   and   python -m unittest -v'",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
